# No credentials are required for clearly labelled demo mode.
PORT=3000
HOST=127.0.0.1
DATA_MODE=demo
DATA_PROVIDER=fuyao
FUYAO_API_KEY=
MODEL_MODE=demo
SQLITE_PATH=./data/buddy.sqlite
# Production: use MySQL 8 or a persistent SQLite disk; set a strong shared session secret.
DATABASE_URL=
# Example: mysql://buddy:password@127.0.0.1:3306/investment_buddy
SESSION_SECRET=
APP_ACCESS_TOKEN=
COOKIE_SECURE=false
# Select a model available to your account. Never put credentials in VITE_* variables.
MODEL_API_STYLE=responses
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
# Data gateway contract: docs/DATA_ADAPTER.md. No invented vendor endpoints.
DATA_GATEWAY_URL=
DATA_GATEWAY_TOKEN=
DATA_ALLOWED_SOURCE_HOSTS=
ENABLE_FAULT_LAB=true
TASK_DELAY_MS=650
# Docker Compose only: set different random alphanumeric passwords before starting.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_BIND=127.0.0.1
